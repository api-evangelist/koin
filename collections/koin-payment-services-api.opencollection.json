{
  "opencollection": "1.0.0",
  "info": {
    "name": "Antifraud Access Payment Services API",
    "version": "2.0"
  },
  "items": [
    {
      "info": {
        "name": "Payment Services",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Get Payment by Reference ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.koin.com.br/v1/payment/orders",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "reference_id",
                "value": "REF0000001",
                "type": "query",
                "description": "Transaction identifier, generated by client. (Maximum of 50 characters - Unique per transaction)."
              }
            ]
          },
          "docs": "Payment details service."
        },
        {
          "info": {
            "name": "Create Payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.koin.com.br/v1/payment/orders",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create payment service. Before required fields will validated and after will validated business rules. Below is a table with the information regarding said api."
        },
        {
          "info": {
            "name": "Get Payments by Transaction ID",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.koin.com.br/v1/payment/orders/lookup",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "transaction_id",
                "value": "TRX0000001",
                "type": "query",
                "description": "Payment identifier, Multiple orders associated with a payment."
              }
            ]
          },
          "docs": "Payment orders."
        },
        {
          "info": {
            "name": "Capture Payment",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api-sandbox.koin.com.br/v1/payment/orders/:order_id/capture",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "order_id",
                "value": "9dd3f765-a51a-49d8-b6af-a51d5a0b3f7f",
                "type": "path",
                "description": "Order ID returned by create payment service"
              }
            ]
          },
          "docs": "Service responsible for capturing a card payment"
        },
        {
          "info": {
            "name": "Get Payment",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api-sandbox.koin.com.br/v1/payment/orders/:order_id",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "order_id",
                "value": "9dd3f765-a51a-49d8-b6af-a51d5a0b3f7f",
                "type": "path",
                "description": "Order ID returned by create payment service"
              }
            ]
          },
          "docs": "Payment details service."
        },
        {
          "info": {
            "name": "Cancel Payment",
            "type": "http"
          },
          "http": {
            "method": "PUT",
            "url": "https://api-sandbox.koin.com.br/v1/payment/orders/:order_id/cancel",
            "headers": [
              {
                "name": "Content-Type",
                "value": "application/json"
              },
              {
                "name": "Accept",
                "value": "application/json"
              }
            ],
            "params": [
              {
                "name": "order_id",
                "value": "9dd3f765-a51a-49d8-b6af-a51d5a0b3f7f",
                "type": "path",
                "description": "Order ID returned by create payment service"
              }
            ]
          },
          "docs": "Cancellation payment. Card, Pix and BNPL payment method can be cancelled, for Pix payment method, you can only cancel dynamic QR payments; for the card payment method, you can cancel **Opened** or **Authorized** payments, which will remain with the status **Canceled** or **Voided** respectively."
        }
      ]
    }
  ],
  "bundled": true
}